@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt@QT_VERSION_MAJOR@Core @QT_MIN_VERSION@)
find_dependency(Qt@QT_VERSION_MAJOR@Gui @QT_MIN_VERSION@)
find_dependency(Qt@QT_VERSION_MAJOR@Widgets @QT_MIN_VERSION@)

set(LIBADWAITA_LIBRARIES libadwaita@LIBADWAITA_SUFFIX@)
set(LIBADWAITA_INCLUDE_DIRS @CMAKE_INSTALL_FULL_INCLUDEDIR@/Adwaita)
include("${CMAKE_CURRENT_LIST_DIR}/LibAdwaita@LIBADWAITA_SUFFIX@Targets.cmake")
